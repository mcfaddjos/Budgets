# Copy to .env and fill in (never commit the real .env or the service account key)

# From the Google Sheet's URL: docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=

# Path to the service account JSON key downloaded from Google Cloud Console.
# Defaults to server/service-account.json if not set.
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=

# Tab names in the sheet, if different from the defaults below.
GOOGLE_SHEET_PURCHASES_TAB=Purchases
GOOGLE_SHEET_BUDGETS_TAB=Budgets
