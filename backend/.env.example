# Copy to .env and fill in.

# Using Neon (decided in PRD §14a). Neon's project dashboard gives you two
# connection strings under "Connect" — grab both:
#
# DATABASE_URL: the POOLED one (hostname contains "-pooler") — used by the
# running app for normal queries.
#
# DIRECT_URL: the UNPOOLED one (same hostname, no "-pooler") — required
# for `prisma migrate`, which fails against a PgBouncer pooled connection
# (no support for the prepared statements a migration needs).
DATABASE_URL=
DIRECT_URL=

PORT=4000
