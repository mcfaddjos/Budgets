// Data model per PRD.md §9, §5b (household/invite design), and §10a
// (end-to-end encryption, decided 2026-09-15).
//
// IDs are UUIDs (cuid would also work; UUID chosen to match the appscript
// backend's Utilities.getUuid()-based ids, so a future data migration from
// the live Sheets DB doesn't need to remap every id).
//
// Encryption convention (§10a): any field holding financial content
// (amounts, descriptions, category/account names, rule patterns) is never
// stored as a plaintext column. Instead each such row carries:
//   - encryptedData: Bytes  — libsodium crypto_secretbox_easy ciphertext of
//     a JSON payload holding that model's sensitive fields, keyed by the
//     household's Data Encryption Key (DEK), which the server never holds.
//   - nonce: Bytes          — the 24-byte nonce used for that secretbox.
// Columns that stay plaintext are either non-sensitive routing/list
// metadata (ids, timestamps, dates, month strings) or foreign keys (an id
// reference doesn't leak the referenced row's encrypted content).

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (PgBouncer) — used by the app at runtime
  directUrl = env("DIRECT_URL") // unpooled — required for prisma migrate against Neon
}

generator client {
  provider = "prisma-client-js"
}

enum HouseholdRole {
  OWNER
  MEMBER
}

model Household {
  id        String   @id @default(uuid())
  name      String?
  createdAt DateTime @default(now())

  members       HouseholdMember[]
  invites       Invite[]
  accounts      Account[]
  categories    Category[]
  categoryRules CategoryRule[]
  transactions  Transaction[]
  budgets       Budget[]
  deviceKeys    DeviceHouseholdKey[]
}

// Identity only — no key material lives here (see UserDevice below).
// Google Sign-In authenticates *who you are* to the server (verified via
// Google's own ID-token signature — no local password verifier needed at
// all for login). Key material is per-device, not per-user, precisely so
// "log in anywhere" is possible: a single publicKey/encryptedPrivateKey
// slot on User would mean the most-recently-added device silently
// invalidates every other one (decision, 2026-09-22, see PRD §10c/§10d —
// this is the schema change that makes multi-device support correct
// rather than a footgun).
model User {
  id        String   @id @default(uuid())
  googleId  String   @unique // Google's stable "sub" claim
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())

  devices             UserDevice[]
  memberships         HouseholdMember[]
  sessions            Session[]
  invitesCreated      Invite[]      @relation("InviteCreator")
  invitesUsed         Invite[]      @relation("InviteRedeemer")
  transactionsCreated Transaction[] @relation("TransactionCreator")
}

// One row per device this user has ever registered a keypair on
// (decision, 2026-09-22 — see PRD §10d). A separate **vault secret**,
// generated on-device and never sent to the server in any form (§10c),
// derives (Argon2id, via vaultKdfSalt) the key that unlocks
// encryptedPrivateKey — same split-secret rationale as before (§10a):
// if Google alone could unlock a device's vault, "the developer can't
// read your data" would quietly become "neither can the developer, nor
// anyone who controls the Google account."
model UserDevice {
  id     String  @id @default(uuid())
  userId String
  name   String? // optional label ("Android", "iPhone") — cosmetic only

  // Public-key identity (libsodium crypto_box keypair) for this device.
  // Other devices (this user's own, or another household member's) wrap
  // a household DEK to this without needing the device online at grant
  // time (crypto_box_seal, §10a).
  publicKey String // base64, safe to be plaintext — this is the public half

  encryptedPrivateKey String // base64 ciphertext
  privateKeyNonce     String // base64, secretbox nonce for the above
  vaultKdfSalt        String // base64, Argon2id salt for re-deriving the
  //                            vault-secret-wrapping key on this device

  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  householdKeys DeviceHouseholdKey[]
}

// This device's wrapped copy of one household's DEK — replaces the old
// single wrappedDek on HouseholdMember, since a household's DEK now needs
// wrapping once per *device*, not once per *user* (a user with two
// devices holds two separate wraps of the same DEK, one per public key).
// Row absence (not a nullable column) is what "pending a grant" means
// now: a brand-new device has no row here until an already-unlocked
// device (this user's own, via device pairing, or another household
// member, via the existing invite/grant flow) wraps the DEK for it.
model DeviceHouseholdKey {
  deviceId    String
  householdId String

  wrappedDek String // base64

  device    UserDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  household Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@id([deviceId, householdId])
}

// Ephemeral, short-lived relay for pairing a new device to an existing
// account without any pre-saved secret (decision, 2026-09-22, see PRD
// §10d) — the primary way to add a device going forward, with the
// recovery code (HouseholdMember.recoveryWrappedDek) as the backstop for
// "every device is gone." The actual pairing secret is generated
// client-side on the already-unlocked device and shown/typed out of
// band (never sent here) — this table only ever relays ciphertext plus a
// MAC the already-unlocked device verifies locally before it ever wraps
// the real DEK, so a compromised server can relay but can't substitute
// its own public key to hijack the pairing. Deleted once consumed or
// expired; nothing here is sensitive on its own (the MAC is only useful
// to someone who already knows the out-of-band secret).
model DevicePairingSession {
  id          String @id @default(uuid())
  userId      String
  householdId String

  // Submitted by the joining device once the user enters/scans the code.
  newPublicKey           String?
  newEncryptedPrivateKey String?
  newPrivateKeyNonce     String?
  newVaultKdfSalt        String?
  newDeviceMac           String? // base64 HMAC(pairingSecret, newPublicKey), verified by the granting device

  // Submitted by the granting device once it verifies newDeviceMac locally.
  wrappedDekForNewDevice String?

  createdAt DateTime @default(now())
  expiresAt DateTime
}

// Membership is a relationship, not a column on User — see PRD §5b. A user
// belonging to more than one household later needs no schema change here,
// just a "which household am I acting in" concept client-side.
//
// Also where a user's recovery code lives (§10a): the household DEK
// encrypted with a high-entropy recovery key generated client-side and
// shown to the user once to store themselves — the server never sees the
// recovery key. Deliberately per-user-per-household, not per-device: the
// same recovery code bootstraps any new device for this user, and doesn't
// require another already-unlocked device to be reachable.
model HouseholdMember {
  householdId String
  userId      String
  role        HouseholdRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  recoveryWrappedDek String? // base64
  recoveryDekNonce   String? // base64

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([householdId, userId])
}

// Household-scoped, replacing the appscript backend's single global
// INVITE_CODE script property — each household mints its own invites.
model Invite {
  id              String    @id @default(uuid())
  householdId     String
  code            String    @unique
  createdByUserId String
  createdAt       DateTime  @default(now())
  expiresAt       DateTime?
  usedByUserId    String?
  usedAt          DateTime?

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy User      @relation("InviteCreator", fields: [createdByUserId], references: [id])
  usedBy    User?     @relation("InviteRedeemer", fields: [usedByUserId], references: [id])
}

// Real session expiry — the appscript backend's sessions never expired,
// flagged as a gap in PRD §10.
model Session {
  token     String   @id @default(uuid())
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// name/type/institution are encrypted (§10a) — the server knows a
// household has an account with this id, not what it's called or what
// kind it is.
model Account {
  id          String @id @default(uuid())
  householdId String

  encryptedData String // base64 — { name, type, institution }
  nonce         String // base64

  // Who this account belongs to (one owner for a single person's credit
  // card, more than one for something like a shared household savings
  // account) — a list of userIds, kept plaintext like createdByUserId
  // elsewhere: it's a reference, not financial content, so §10a's
  // encryption rule doesn't apply. No FK/cascade on the array entries
  // (Postgres text[] can't reference a table) — a user being removed from
  // the household doesn't currently clean this up; not a concern yet at
  // today's household scale.
  ownerUserIds String[] @default([])

  createdAt    DateTime      @default(now())
  household    Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  transactions Transaction[]
}

// name is encrypted (§10a) — uniqueness-per-household is now enforced
// client-side (decrypt the household's categories, check for a name
// collision) rather than via a DB constraint, since the server can't read
// names to compare them.
model Category {
  id          String @id @default(uuid())
  householdId String

  encryptedData String // base64 — { name }
  nonce         String // base64

  household    Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  rules        CategoryRule[]
  transactions Transaction[]
  budgets      Budget[]
}

// pattern (the merchant/keyword match string) is encrypted (§10a) —
// matching a transaction description against household rules now happens
// client-side, alongside categorization generally, since the server never
// holds plaintext descriptions or patterns to compare.
model CategoryRule {
  id          String @id @default(uuid())
  householdId String
  categoryId  String

  encryptedData String // base64 — { pattern }
  nonce         String // base64

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model Transaction {
  id          String @id @default(uuid())
  householdId String
  accountId   String
  categoryId  String?

  // Kept plaintext (§10a: minimal metadata needed to route/list) as a
  // YYYY-MM-DD string, matching the existing month-prefix filtering logic
  // ported from the appscript backend — revisit if that filtering becomes
  // a real date-range query.
  date String

  // description, normalizedDescription, and amount are encrypted (§10a):
  // { description, normalizedDescription, amount }
  encryptedData String // base64
  nonce         String // base64

  // Deterministic, keyed dedup fingerprint — HMAC(householdDEK, date +
  // "|" + amount + "|" + normalizedDescription), computed client-side, so
  // the server can still enforce "no duplicate transaction per account"
  // via a DB unique constraint without ever seeing the underlying values.
  dedupKey String

  reviewed        Boolean  @default(false)
  createdByUserId String?
  createdAt       DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category  Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy User?     @relation("TransactionCreator", fields: [createdByUserId], references: [id])

  @@unique([accountId, dedupKey])
  @@index([householdId, date])
}

// amount is encrypted (§10a); householdId/categoryId/month stay plaintext
// since they're just routing keys, not financial content, and the
// existing @@unique constraint (one budget row per category per month)
// still works unchanged since it doesn't touch the encrypted field.
model Budget {
  id          String @id @default(uuid())
  householdId String
  categoryId  String
  month       String // YYYY-MM

  encryptedData String // base64 — { amount }
  nonce         String // base64

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([householdId, categoryId, month])
}
