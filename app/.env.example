# Copy to .env and fill in. EXCEPTION: the receipt-scanning keys below are
# real secrets (unlike everything else in this file) — put those in a
# separate .env.local instead (gitignored, Expo loads it as an override on
# top of .env automatically) so a real key never lands in git history. Note
# this doesn't keep the key out of the *compiled app* itself — that's the
# accepted tradeoff from PRD §8.6's "embedded client-side" decision, not
# something .env.local changes; it only keeps the repo clean.

# The Web OAuth client ID from Google Cloud Console (see PRD §10a) — not a
# secret, it's the public identifier a Google Sign-In request is scoped
# to. Use the WEB client ID specifically (not an Android/iOS-specific
# one), so the ID token's audience matches the single GOOGLE_CLIENT_ID the
# backend verifies against.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# iOS only — a second, separate OAuth client (type "iOS", not "Web") from
# the same Google Cloud project, scoped to this app's iOS bundle
# identifier (app.json's ios.bundleIdentifier) rather than a SHA-1 the
# way the Android client is. Required for the native iOS sign-in sheet to
# work at all; the ID token it produces is still audienced to
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID above, not this one. Leave blank on
# Android — never read there. If this value ever changes, app.json's
# google-signin plugin iosUrlScheme also needs updating by hand (Google's
# convention: "com.googleusercontent.apps." + this client ID's prefix
# before ".apps.googleusercontent.com") — the two aren't derived from
# each other automatically.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Local dev backend — point at wherever `npm run dev` is listening
# (backend/README.md). Three cases:
#   - Physical device over USB (current setup): keep this as localhost,
#     and run `adb reverse tcp:4000 tcp:4000` once per USB
#     connection/adb-server-restart — tunnels the phone's localhost:4000
#     back to this machine over the cable, no WiFi/LAN dependency.
#   - Android emulator: use 10.0.2.2 instead (the emulator's alias for
#     the host machine) — localhost inside the emulator means itself.
#   - Physical device over WiFi (no adb reverse): use this machine's LAN IP.
# Once deployed, point this at the Render URL instead.
EXPO_PUBLIC_SERVER_URL=http://localhost:4000/api

# Receipt scanning (PRD §8.6) — put real values in .env.local, not here.
#
# Azure AI Document Intelligence resource (portal.azure.com, free F0
# tier — 500 pages/month). Endpoint looks like
# https://<resource-name>.cognitiveservices.azure.com — used for the
# prebuilt-receipt model, itemized receipts only.
EXPO_PUBLIC_AZURE_DOC_INTEL_ENDPOINT=
EXPO_PUBLIC_AZURE_DOC_INTEL_KEY=

# Anthropic API key (console.anthropic.com) — used for gas-pump and
# payment-screenshot capture, which aren't itemized receipts so Azure's
# model doesn't fit them (see app/src/receipts/extractReceipt.js).
EXPO_PUBLIC_ANTHROPIC_API_KEY=
