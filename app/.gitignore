# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files — app/.env is deliberately un-ignored below: every
# value in it is a public OAuth client ID or the already-public Render
# URL, nothing secret (see backend/.env, kept ignored, for the one file
# that actually holds a credential — a Neon DB password).
.env
!.env
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
